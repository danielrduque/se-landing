# Copia este archivo como .env y pega tus claves (separadas por comas; si una falla se usa la siguiente).
# Gemini (gratis): https://aistudio.google.com/apikey
AI_API_KEYS=clave-1,clave-2
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
# Modelos de respaldo si el principal está saturado o sin permiso (separados por comas)
AI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
