{
 "title": "xbox · T1+T7+T8",
 "html": "<!DOCTYPE html>\n<html lang=\"es\" class=\"scroll-smooth\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Xbox Series X | Potencia Pura. Sin Fricción.</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Space+Grotesk:wght@500;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        /* RESET & TOKENS (Bauhaus Minimalismo Funcional) */\n        :root {\n            --xbox-green: #107C41;\n            --carbon: #111111;\n            --off-white: #F2F2F2;\n            --accent-yellow: #FFDE00;\n            --industrial-gray: #333333;\n            --surface-gray: #1E1E1E;\n            --font-display: 'Space Grotesk', sans-serif;\n            --font-body: 'Inter', sans-serif;\n        }\n\n        *, *::before, *::after {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n            border-radius: 0 !important; /* Estricto cumplimiento Bauhaus */\n        }\n\n        body {\n            background-color: var(--carbon);\n            color: var(--off-white);\n            font-family: var(--font-body);\n            line-height: 1.5;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n        }\n\n        /* Utilidades de retícula geométrica */\n        .grid-line-v {\n            position: absolute;\n            top: 0;\n            bottom: 0;\n            width: 1px;\n            background-color: var(--industrial-gray);\n            z-index: 1;\n            pointer-events: none;\n        }\n\n        .container {\n            width: 100%;\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 0 2rem;\n            position: relative;\n        }\n\n        /* HEADER / NAVBAR */\n        header {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            background-color: rgba(17, 17, 17, 0.95);\n            backdrop-filter: blur(8px);\n            border-bottom: 2px solid var(--industrial-gray);\n            z-index: 1000;\n        }\n\n        .nav-container {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            height: 80px;\n        }\n\n        .logo-area {\n            display: flex;\n            align-items: center;\n            gap: 1.5rem;\n        }\n\n        .logo-svg {\n            width: 36px;\n            height: 36px;\n            fill: var(--xbox-green);\n        }\n\n        .brand-name {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            letter-spacing: -0.05em;\n            color: var(--off-white);\n            text-transform: uppercase;\n            text-decoration: none;\n        }\n\n        .nav-links {\n            display: flex;\n            gap: 3rem;\n            list-style: none;\n        }\n\n        .nav-links a {\n            color: var(--off-white);\n            text-decoration: none;\n            font-family: var(--font-display);\n            font-size: 0.875rem;\n            text-transform: uppercase;\n            letter-spacing: 0.1em;\n            transition: color 0.2s ease;\n        }\n\n        .nav-links a:hover {\n            color: var(--xbox-green);\n        }\n\n        .nav-cta {\n            background-color: var(--xbox-green);\n            color: var(--off-white);\n            padding: 0.75rem 1.5rem;\n            font-family: var(--font-display);\n            font-size: 0.875rem;\n            text-transform: uppercase;\n            font-weight: 700;\n            text-decoration: none;\n            border: 2px solid var(--xbox-green);\n            transition: background-color 0.2s, color 0.2s;\n        }\n\n        .nav-cta:hover {\n            background-color: transparent;\n            color: var(--xbox-green);\n        }\n\n        /* HERO SECTION — Diseño Asimétrico Bauhaus (Fuera del estándar Izq/Der) */\n        .hero {\n            padding-top: calc(80px + 6rem);\n            padding-bottom: 6rem;\n            border-bottom: 2px solid var(--industrial-gray);\n            position: relative;\n        }\n\n        .hero-layout {\n            display: grid;\n            grid-template-columns: 1fr 400px;\n            gap: 4rem;\n            align-items: start;\n        }\n\n        .hero-main-title {\n            font-family: var(--font-display);\n            font-size: clamp(3rem, 7vw, 6.5rem);\n            line-height: 0.95;\n            font-weight: 700;\n            text-transform: uppercase;\n            letter-spacing: -0.03em;\n            margin-bottom: 2rem;\n        }\n\n        .hero-main-title span {\n            color: var(--xbox-green);\n            display: block;\n        }\n\n        .hero-text-block {\n            max-width: 600px;\n            font-size: 1.125rem;\n            color: #AAAAAA;\n            margin-bottom: 3rem;\n            border-left: 4px solid var(--accent-yellow);\n            padding-left: 1.5rem;\n        }\n\n        .hero-actions {\n            display: flex;\n            gap: 1.5rem;\n            align-items: center;\n        }\n\n        .btn-primary {\n            background-color: var(--accent-yellow);\n            color: var(--carbon);\n            padding: 1.25rem 2.5rem;\n            font-family: var(--font-display);\n            font-weight: 700;\n            font-size: 1rem;\n            text-transform: uppercase;\n            text-decoration: none;\n            border: 2px solid var(--accent-yellow);\n            display: inline-block;\n            transition: transform 0.1s ease, background-color 0.2s;\n        }\n\n        .btn-primary:hover {\n            background-color: transparent;\n            color: var(--accent-yellow);\n        }\n\n        .btn-secondary {\n            background-color: transparent;\n            color: var(--off-white);\n            padding: 1.25rem 2.5rem;\n            font-family: var(--font-display);\n            font-weight: 700;\n            font-size: 1rem;\n            text-transform: uppercase;\n            text-decoration: none;\n            border: 2px solid var(--industrial-gray);\n            display: inline-block;\n            transition: border-color 0.2s, color 0.2s;\n        }\n\n        .btn-secondary:hover {\n            border-color: var(--off-white);\n        }\n\n        /* Panel lateral geométrico purista para el Hero */\n        .hero-sidebar-panel {\n            background-color: var(--surface-gray);\n            border: 2px solid var(--industrial-gray);\n            padding: 2.5rem;\n            position: relative;\n        }\n\n        .specs-mini-list {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: 2rem;\n        }\n\n        .specs-mini-item {\n            border-bottom: 1px solid var(--industrial-gray);\n            padding-bottom: 1.5rem;\n        }\n\n        .specs-mini-item:last-child {\n            border-bottom: none;\n            padding-bottom: 0;\n        }\n\n        .spec-label {\n            font-family: var(--font-display);\n            font-size: 0.75rem;\n            text-transform: uppercase;\n            color: #777777;\n            letter-spacing: 0.1em;\n            display: block;\n            margin-bottom: 0.25rem;\n        }\n\n        .spec-value {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--off-white);\n        }\n\n        /* SECCIÓN ESPECIFICACIONES / RENDIMIENTO (SVG Industrial Minimalista) */\n        .hardware-section {\n            padding: 8rem 0;\n            border-bottom: 2px solid var(--industrial-gray);\n            background-color: #0D0D0D;\n        }\n\n        .section-header {\n            margin-bottom: 5rem;\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-end;\n        }\n\n        .section-title {\n            font-family: var(--font-display);\n            font-size: clamp(2.5rem, 5vw, 4rem);\n            text-transform: uppercase;\n            line-height: 1;\n            font-weight: 700;\n        }\n\n        .section-subtitle {\n            font-family: var(--font-display);\n            font-size: 0.875rem;\n            color: var(--xbox-green);\n            text-transform: uppercase;\n            letter-spacing: 0.2em;\n            margin-bottom: 1rem;\n            display: block;\n        }\n\n        /* Arquitectura de Hardware en Grilla Asimétrica sin tarjetas flotantes */\n        .hardware-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2px;\n            background-color: var(--industrial-gray);\n            border: 2px solid var(--industrial-gray);\n        }\n\n        .hardware-card {\n            background-color: var(--carbon);\n            padding: 3rem;\n            display: flex;\n            flex-direction: column;\n            justify-content: space-between;\n            min-height: 400px;\n        }\n\n        .hardware-icon-box {\n            width: 64px;\n            height: 64px;\n            background-color: var(--surface-gray);\n            border: 1px solid var(--industrial-gray);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 2rem;\n        }\n\n        .hardware-card h3 {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            text-transform: uppercase;\n            margin-bottom: 1rem;\n        }\n\n        .hardware-card p {\n            color: #999999;\n            font-size: 0.95rem;\n        }\n\n        /* SECCIÓN GAME PASS — El Ecosistema sin Fricción */\n        .ecosystem-section {\n            padding: 8rem 0;\n            border-bottom: 2px solid var(--industrial-gray);\n            position: relative;\n        }\n\n        .ecosystem-layout {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n        }\n\n        .ecosystem-content h2 {\n            font-family: var(--font-display);\n            font-size: clamp(2.5rem, 4vw, 3.5rem);\n            text-transform: uppercase;\n            line-height: 1.05;\n            margin-bottom: 2rem;\n        }\n\n        .ecosystem-content p {\n            color: #AAAAAA;\n            font-size: 1.125rem;\n            margin-bottom: 2.5rem;\n        }\n\n        .feature-check-list {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n            margin-bottom: 3rem;\n        }\n\n        .feature-check-item {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n            font-family: var(--font-display);\n            font-size: 1rem;\n            text-transform: uppercase;\n        }\n\n        .feature-check-item svg {\n            flex-shrink: 0;\n            width: 20px;\n            height: 20px;\n            fill: var(--xbox-green);\n        }\n\n        /* Consola interactiva visual / SVG Diagrama Técnico Bauhaus */\n        .diagram-container {\n            background-color: var(--surface-gray);\n            border: 2px solid var(--industrial-gray);\n            padding: 3rem;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 500px;\n            position: relative;\n        }\n\n        /* SECCIÓN PRICING / CTA FINAL */\n        .pricing-section {\n            padding: 8rem 0;\n            background-color: #0A0A0A;\n            text-align: center;\n        }\n\n        .pricing-box {\n            max-width: 800px;\n            margin: 0 auto;\n            border: 2px solid var(--industrial-gray);\n            background-color: var(--carbon);\n            padding: 5rem 3rem;\n            position: relative;\n        }\n\n        .pricing-box::before {\n            content: 'OFERTA DE LANZAMIENTO';\n            position: absolute;\n            top: -14px;\n            left: 50%;\n            transform: translateX(-50%);\n            background-color: var(--xbox-green);\n            color: var(--off-white);\n            font-family: var(--font-display);\n            font-size: 0.75rem;\n            font-weight: 700;\n            padding: 0.25rem 1rem;\n            letter-spacing: 0.1em;\n            text-transform: uppercase;\n        }\n\n        .pricing-title {\n            font-family: var(--font-display);\n            font-size: clamp(2rem, 4vw, 3rem);\n            text-transform: uppercase;\n            margin-bottom: 1.5rem;\n        }\n\n        .pricing-price {\n            font-family: var(--font-display);\n            font-size: 5rem;\n            font-weight: 700;\n            color: var(--accent-yellow);\n            line-height: 1;\n            margin-bottom: 0.5rem;\n        }\n\n        .pricing-period {\n            font-family: var(--font-display);\n            text-transform: uppercase;\n            color: #777777;\n            font-size: 0.875rem;\n            letter-spacing: 0.1em;\n            margin-bottom: 3rem;\n        }\n\n        /* FOOTER */\n        footer {\n            background-color: var(--carbon);\n            border-top: 2px solid var(--industrial-gray);\n            padding: 4rem 0;\n        }\n\n        .footer-content {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            border-bottom: 1px solid var(--industrial-gray);\n            padding-bottom: 3rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer-legal {\n            color: #666666;\n            font-size: 0.75rem;\n            line-height: 1.6;\n        }\n\n        /* RESPONSIVE */\n        @media (max-width: 1024px) {\n            .hero-layout {\n                grid-template-columns: 1fr;\n            }\n            .hardware-grid {\n                grid-template-columns: 1fr;\n            }\n            .ecosystem-layout {\n                grid-template-columns: 1fr;\n            }\n            .nav-links {\n                display: none;\n            }\n        }\n    </style>\n</head>\n<body>\n\n    <!-- \n      MAPA DE BLOQUES ESTRUCTURALES Y DOCUMENTACIÓN DE IA (Prompt / Fase 1 & 2):\n      [T1] Seed String: Minimalismo funcional Bauhaus aplicado al hardware gaming.\n      [T7] Restricciones aplicadas: Cero lenguaje corporativo inflado, cero degradados púrpuras, cero neón genérico de stock, cero bento grids flotantes. Textos directos (\"De gamer a gamer\").\n      [Prompt de Imagen/Video de Referencia - Solo Texto]: \n      \"Raw documentary photography of a matte black monolithic gaming console sitting on raw concrete surface, sharp industrial lighting, extreme close-up on precision vents, high contrast, non-commercial candid realism --ar 16:9\"\n    -->\n\n    <!-- HEADER -->\n    <header>\n        <div class=\"container nav-container\">\n            <div class=\"logo-area\">\n                <svg class=\"logo-svg\" viewBox=\"0 0 24 24\">\n                    <path d=\"M18.71 4.5C17.07 3.03 14.79 2.13 12 2.13S6.93 3.03 5.29 4.5C2.5 7 1 10.6 1 14.5c0 5 3.5 8.37 8.5 8.37 1.74 0 3.5-.54 5-1.5 1.5.96 3.26 1.5 5 1.5 5 0 8.5-3.37 8.5-8.37 0-3.9-1.5-7.5-4.29-10zM12 19.5c-3.13 0-5.5-1.92-6.5-4.75 2.13-1.04 4.19-2.5 6.15-4.34 1.96 1.84 4.02 3.3 6.15 4.34-1 2.83-3.37 4.75-6.5 4.75zm7.34-9.3c-1.85-.92-3.72-2.22-5.45-3.83 1.25-1.12 2.72-1.92 4.31-2.34 1.14 1.22 1.85 2.84 2.05 4.63-.3.18-.6.35-.91.54zM4.66 10.2c.2-1.79.91-3.41 2.05-4.63 1.59.42 3.06 1.22 4.31 2.34-1.73 1.61-3.6 2.91-5.45 3.83-.31-.19-.61-.36-.91-.54z\"/>\n                </svg>\n                <a href=\"#\" class=\"brand-name\">Xbox Series X</a>\n            </div>\n            <ul class=\"nav-links\">\n                <li><a href=\"#hardware\">Hardware</a></li>\n                <li><a href=\"#ecosystem\">Game Pass</a></li>\n                <li><a href=\"#pricing\">Precio</a></li>\n            </ul>\n            <a href=\"#pricing\" class=\"nav-cta\">Prueba 1 Mes · 1€</a>\n        </div>\n    </header>\n\n    <!-- HERO SECTION -->\n    <section class=\"hero\">\n        <div class=\"container\">\n            <div class=\"hero-layout\">\n                <div>\n                    <span class=\"section-subtitle\">01 / Arquitectura de Nueva Generación</span>\n                    <h1 class=\"hero-main-title\">\n                        Potencia Pura.\n                        <span>Sin Fricción.</span>\n                    </h1>\n                    <p class=\"hero-text-block\">\n                        Olvídate de tiempos de carga absurdos y actualizaciones eternas. Xbox Series X está diseñada por y para jugadores que exigen rendimiento real a 4K y 120 fotogramas por segundo estables.\n                    </p>\n                    <div class=\"hero-actions\">\n                        <a href=\"#pricing\" class=\"btn-primary\">Consigue la tuya</a>\n                        <a href=\"#hardware\" class=\"btn-secondary\">Ver especificaciones</a>\n                    </div>\n                </div>\n                \n                <!-- Panel lateral geométrico purista -->\n                <div class=\"hero-sidebar-panel\">\n                    <ul class=\"specs-mini-list\">\n                        <li class=\"specs-mini-item\">\n                            <span class=\"spec-label\">Rendimiento Gráfico</span>\n                            <span class=\"spec-value\">12 Teraflops</span>\n                        </li>\n                        <li class=\"specs-mini-item\">\n                            <span class=\"spec-label\">Velocidad de Carga</span>\n                            <span class=\"spec-value\">SSD NVMe Custom</span>\n                        </li>\n                        <li class=\"specs-mini-item\">\n                            <span class=\"spec-label\">Resolución y Tasa</span>\n                            <span class=\"spec-value\">4K / 120 FPS Real</span>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- HARDWARE SECTION -->\n    <section id=\"hardware\" class=\"hardware-section\">\n        <div class=\"container\">\n            <div class=\"section-header\">\n                <div>\n                    <span class=\"section-subtitle\">02 / Ingeniería sin concesiones</span>\n                    <h2 class=\"section-title\">Diseñada para rendir.<br>Punto.</h2>\n                </div>\n            </div>\n\n            <!-- Grilla asimétrica basada en Bauhaus -->\n            <div class=\"hardware-grid\">\n                <!-- Tarjeta 1 -->\n                <div class=\"hardware-card\">\n                    <div class=\"hardware-icon-box\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"var(--xbox-green)\"><path d=\"M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z\"/></svg>\n                    </div>\n                    <div>\n                        <h3>Arquitectura Velocity</h3>\n                        <p>Hardware y software integrados a la perfección. Reducimos los tiempos de carga a segundos para que pases tu tiempo jugando, no esperando frente a una pantalla en negro.</p>\n                    </div>\n                </div>\n                <!-- Tarjeta 2 -->\n                <div class=\"hardware-card\">\n                    <div class=\"hardware-icon-box\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"var(--xbox-green)\"><path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"/></svg>\n                    </div>\n                    <div>\n                        <h3>Ray Tracing por Hardware</h3>\n                        <p>Iluminación, sombras y reflejos hiperrealistas calculados en tiempo real. Entornos virtuales que responden con precisión física absoluta a cada acción tuya.</p>\n                    </div>\n                </div>\n                <!-- Tarjeta 3 -->\n                <div class=\"hardware-card\">\n                    <div class=\"hardware-icon-box\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"var(--xbox-green)\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z\"/></svg>\n                    </div>\n                    <div>\n                        <h3>Quick Resume</h3>\n                        <p>Cambia instantáneamente entre múltiples juegos suspendidos. Vuelve exactamente al punto donde lo dejaste sin pasar por menús de carga ni pantallas de inicio.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- ECOSYSTEM SECTION -->\n    <section id=\"ecosystem\" class=\"ecosystem-section\">\n        <div class=\"container\">\n            <div class=\"ecosystem-layout\">\n                <div class=\"ecosystem-content\">\n                    <span class=\"section-subtitle\">03 / Xbox Game Pass</span>\n                    <h2>Un catálogo masivo.<br>Una sola suscripción.</h2>\n                    <p>\n                        Corta con la fricción de comprar juegos individuales a precios absurdos. Accede desde el primer día a lanzamientos de primer nivel, juegos independientes aclamados y toda la biblioteca de Bethesda y Xbox Game Studios.\n                    </p>\n                    <ul class=\"feature-check-list\">\n                        <li class=\"feature-check-item\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z\"/></svg>\n                            Lanzamientos el mismo día de estreno\n                        </li>\n                        <li class=\"feature-check-item\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z\"/></svg>\n                            Cientos de juegos listos para consola y PC\n                        </li>\n                        <li class=\"feature-check-item\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z\"/></svg>\n                            Juega en la nube desde cualquier dispositivo\n                        </li>\n                    </ul>\n                    <a href=\"#pricing\" class=\"btn-primary\">Empieza por 1€</a>\n                </div>\n\n                <!-- SVG Diagrama Técnico Bauhaus (Sin imágenes externas) -->\n                <div class=\"diagram-container\">\n                    <svg width=\"100%\" height=\"320\" viewBox=\"0 0 400 320\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <!-- Estructura geométrica tipo plano técnico industrial -->\n                        <rect x=\"120\" y=\"40\" width=\"160\" height=\"240\" stroke=\"#107C41\" stroke-width=\"4\" fill=\"#111\"/>\n                        <line x1=\"120\" y1=\"100\" x2=\"280\" y2=\"100\" stroke=\"#333\" stroke-width=\"2\"/>\n                        <circle cx=\"200\" cy=\"180\" r=\"40\" stroke=\"#FFDE00\" stroke-width=\"2\" stroke-dasharray=\"4 4\"/>\n                        <circle cx=\"200\" cy=\"180\" r=\"10\" fill=\"#107C41\"/>\n                        <path d=\"M140 250H260\" stroke=\"#777\" stroke-width=\"2\"/>\n                        <path d=\"M140 70H160\" stroke=\"#777\" stroke-width=\"2\"/>\n                        <path d=\"M240 70H260\" stroke=\"#777\" stroke-width=\"2\"/>\n                        <text x=\"145\" y=\"275\" fill=\"#777\" font-family=\"Space Grotesk, sans-serif\" font-size=\"10\" letter-spacing=\"2\">XBOX_SYS_v4.2</text>\n                    </svg>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- PRICING SECTION / CTA FINAL -->\n    <section id=\"pricing\" class=\"pricing-section\">\n        <div class=\"container\">\n            <div class=\"pricing-box\">\n                <h2 class=\"pricing-title\">Da el salto definitivo</h2>\n                <p style=\"color: #999999; margin-bottom: 2.5rem;\">Prueba Xbox Game Pass Ultimate durante tu primer mes y accede a todo el catálogo sin compromisos.</p>\n                <div class=\"pricing-price\">1€</div>\n                <div class=\"pricing-period\">Primer mes / Cancela cuando quieras</div>\n                <div style=\"display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;\">\n                    <a href=\"#\" class=\"btn-primary\">Suscríbete por 1€</a>\n                    <a href=\"#\" class=\"btn-secondary\">Comprar Consola</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- FOOTER -->\n    <footer>\n        <div class=\"container\">\n            <div class=\"footer-content\">\n                <div class=\"logo-area\">\n                    <svg class=\"logo-svg\" viewBox=\"0 0 24 24\" style=\"width: 24px; height: 24px;\">\n                        <path d=\"M18.71 4.5C17.07 3.03 14.79 2.13 12 2.13S6.93 3.03 5.29 4.5C2.5 7 1 10.6 1 14.5c0 5 3.5 8.37 8.5 8.37 1.74 0 3.5-.54 5-1.5 1.5.96 3.26 1.5 5 1.5 5 0 8.5-3.37 8.5-8.37 0-3.9-1.5-7.5-4.29-10zM12 19.5c-3.13 0-5.5-1.92-6.5-4.75 2.13-1.04 4.19-2.5 6.15-4.34 1.96 1.84 4.02 3.3 6.15 4.34-1 2.83-3.37 4.75-6.5 4.75zm7.34-9.3c-1.85-.92-3.72-2.22-5.45-3.83 1.25-1.12 2.72-1.92 4.31-2.34 1.14 1.22 1.85 2.84 2.05 4.63-.3.18-.6.35-.91.54zM4.66 10.2c.2-1.79.91-3.41 2.05-4.63 1.59.42 3.06 1.22 4.31 2.34-1.73 1.61-3.6 2.91-5.45 3.83-.31-.19-.61-.36-.91-.54z\"/>\n                    </svg>\n                    <span class=\"brand-name\" style=\"font-size: 